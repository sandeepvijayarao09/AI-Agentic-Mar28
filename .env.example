# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth redirect URI
OAUTH_REDIRECT_URI=http://localhost:8080/auth/gmail/callback

# Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# App
APP_SECRET_KEY=change-this-to-a-random-secret
APP_ENV=development
APP_PORT=8080

# Database
DATABASE_URL=sqlite:///./second_brain.db

# Opt-in: let the shopping/food agents drive a visible Chromium window (Playwright).
# Off by default; when off, the agents return search links instead.
ENABLE_BROWSER_AUTOMATION=0

# Demo mode: seed an empty database with synthetic orders on startup so the
# UI works without Gmail. Chat still needs GEMINI_API_KEY.
DEMO_MODE=0
